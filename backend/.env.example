# Variables de entorno del backend (INFRA §2). Copiar a .env y completar; .env no se versiona.

# Conexión por session pooler de Supabase (puerto 5432). En local, PostgreSQL en Docker.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres

# Proyecto Supabase: JWKS, emisor del JWT y Admin API
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Solo si el proyecto firma los JWT con HS256 (AUTH §2)
SUPABASE_JWT_SECRET=

# Origen del frontend permitido por CORS
FRONTEND_ORIGIN=http://localhost:5173

# Solo para scripts/create_admin.py; el servicio no las necesita
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
