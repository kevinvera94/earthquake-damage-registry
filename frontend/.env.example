# Variables de entorno del frontend (INFRA §2). Copiar a .env.local y completar; no se versiona.
# Vite solo expone al navegador las variables con prefijo VITE_.

# URL del backend (Render en producción)
VITE_API_URL=http://localhost:8000

# Supabase: solo para el login. La clave anónima es pública por diseño (AUTH §4)
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
